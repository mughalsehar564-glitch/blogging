{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd blog && npm install --include=dev",
  "buildCommand": "cd blog && npm run build",
  "outputDirectory": "blog/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
